# Local / documentation only. Copy to .env if you want overrides.
# Never commit a real .env. Render injects these in the dashboard / Blueprint.

DB_HOST=db
DB_PORT=5432
DB_NAME=odoo
DB_USER=odoo
DB_PASSWORD=change-me
# Optional alternative to the DB_* fields (parsed; not passed raw to Odoo):
# DATABASE_URL=postgresql://odoo:change-me@db:5432/odoo

ODOO_ADMIN_PASSWD=generate-a-long-random-secret
PORT=8069

# Production on Render should use:
# ODOO_LIST_DB=False
# ODOO_PROXY_MODE=True
# ODOO_WORKERS=0
ODOO_LIST_DB=True
ODOO_PROXY_MODE=False
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=1
ODOO_LOG_LEVEL=info
ODOO_WITHOUT_DEMO=True
ODOO_AUTO_INIT_IF_EMPTY=true
