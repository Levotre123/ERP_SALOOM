<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_appointment_company" model="ir.rule">
        <field name="name">Appointment: company</field>
        <field name="model_id" ref="model_salon_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_appointment_establishment" model="ir.rule">
        <field name="name">Appointment: assigned establishments</field>
        <field name="model_id" ref="model_salon_appointment"/>
        <field name="domain_force">[('establishment_id', 'in', user.establishment_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('multi_activity_security.group_hairdresser')), (4, ref('multi_activity_security.group_cashier')), (4, ref('multi_activity_security.group_manager'))]"/>
    </record>
    <record id="rule_appointment_owner" model="ir.rule">
        <field name="name">Appointment: owner company</field>
        <field name="model_id" ref="model_salon_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('multi_activity_security.group_tenant_owner')), (4, ref('multi_activity_security.group_company_admin'))]"/>
    </record>
</odoo>
