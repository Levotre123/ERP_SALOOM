<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_establishment" model="ir.ui.view">
        <field name="name">res.users.form.establishment</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Establishments" name="ma_establishments">
                    <group>
                        <field name="lang"/>
                        <field name="tz"/>
                        <field name="establishment_ids" widget="many2many_tags"/>
                        <field name="default_establishment_id"/>
                        <field name="current_establishment_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
