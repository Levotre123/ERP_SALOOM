<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feature_list" model="ir.ui.view">
        <field name="name">multi.activity.feature.list</field>
        <field name="model">multi.activity.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_feature_form" model="ir.ui.view">
        <field name="name">multi.activity.feature.form</field>
        <field name="model">multi.activity.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_feature" model="ir.actions.act_window">
        <field name="name">Features</field>
        <field name="res_model">multi.activity.feature</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
