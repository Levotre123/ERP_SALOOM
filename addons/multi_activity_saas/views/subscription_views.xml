<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">multi.activity.subscription.list</field>
        <field name="model">multi.activity.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="next_invoice_date"/>
            </list>
        </field>
    </record>
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">multi.activity.subscription.form</field>
        <field name="model">multi.activity.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,trial,active,past_due,grace,suspended,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tenant_id"/>
                            <field name="plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="next_invoice_date"/>
                            <field name="grace_days"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">multi.activity.subscription.search</field>
        <field name="model">multi.activity.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenant_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_trial" string="Trial" domain="[('state', '=', 'trial')]"/>
            </search>
        </field>
    </record>
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">multi.activity.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
