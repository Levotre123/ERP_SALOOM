<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_provisioning_log_list" model="ir.ui.view">
        <field name="name">multi.activity.provisioning.log.list</field>
        <field name="model">multi.activity.provisioning.log</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="tenant_id"/>
                <field name="state"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="view_provisioning_log_form" model="ir.ui.view">
        <field name="name">multi.activity.provisioning.log.form</field>
        <field name="model">multi.activity.provisioning.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="state"/>
                        <field name="create_date"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_provisioning_log" model="ir.actions.act_window">
        <field name="name">Provisioning Logs</field>
        <field name="res_model">multi.activity.provisioning.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
