<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plan_list" model="ir.ui.view">
        <field name="name">multi.activity.plan.list</field>
        <field name="model">multi.activity.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="currency_id" optional="hide"/>
                <field name="billing_period"/>
                <field name="max_establishments"/>
                <field name="max_users"/>
                <field name="trial_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_plan_form" model="ir.ui.view">
        <field name="name">multi.activity.plan.form</field>
        <field name="model">multi.activity.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="price"/>
                            <field name="billing_period"/>
                            <field name="max_establishments"/>
                            <field name="max_users"/>
                            <field name="trial_days"/>
                        </group>
                    </group>
                    <group string="Features">
                        <field name="feature_ids" widget="many2many_tags"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">multi.activity.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
