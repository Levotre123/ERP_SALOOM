<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_table_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="establishment_id"/>
                <field name="seats"/>
                <field name="waiter_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="establishment_id"/>
                        <field name="seats"/>
                        <field name="waiter_id"/>
                        <field name="state"/>
                    </group>
                    <field name="order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="waiter_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_table" model="ir.actions.act_window">
        <field name="name">Tables</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
