<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_order_list" model="ir.ui.view">
        <field name="name">restaurant.order.list</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="table_id"/>
                <field name="establishment_id"/>
                <field name="waiter_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_restaurant_order_form" model="ir.ui.view">
        <field name="name">restaurant.order.form</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_kitchen" type="object" string="Send to kitchen" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_ready" type="object" string="Ready" invisible="state != 'preparation'"/>
                    <button name="action_served" type="object" string="Served" invisible="state != 'ready'"/>
                    <button name="action_paid" type="object" string="Paid" invisible="state not in ('served', 'ready')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,preparation,ready,served,paid"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="table_id"/>
                        <field name="establishment_id"/>
                        <field name="waiter_id"/>
                        <field name="pos_order_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_restaurant_order" model="ir.actions.act_window">
        <field name="name">Kitchen / Orders</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
