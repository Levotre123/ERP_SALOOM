<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_list_establishment" model="ir.ui.view">
        <field name="name">pos.config.list.establishment</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="establishment_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
